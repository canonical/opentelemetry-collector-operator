groups:
- name: HostArpCache
  rules:
  - alert: HostArpCache
    expr: 100 * node_arp_entries / node_sysctl_net_ipv4_neigh_default_gc_thresh3 >= 80
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: Host arp cache reached {{ $value | printf "%.0f" }}% limit (unit {{ $labels.juju_unit }} in model {{ $labels.juju_model }})
      description: >-
        Host arp cache reached {{ $value | printf "%.0f" }}% limit.
          VALUE = {{ $value }}
          LABELS = {{ $labels }}
