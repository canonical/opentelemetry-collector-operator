groups:
- name: HostUseful
  rules:
  - alert: HostSystemdFailedScopes
    expr: sum(node_systemd_unit_state{name=~".*.scope", state=~"failed"}) by (instance) >= 50
    for: 5m
    labels:
      severity: info
    annotations:
      summary: Host has {{ $value }} systemd scopes in failed state (unit {{ $labels.juju_unit }} in model {{ $labels.juju_model }})
      description: >-
        Host has {{ $value }} systemd scopes in failed state.
          VALUE = {{ $value }}
          LABELS = {{ $labels }}
  - alert: HostLoggedInUsers
    expr: sum(node_logind_sessions{class="user"}) by (instance) > 25
    for: 5m
    labels:
      severity: info
    annotations:
      summary: Host has {{ $value }} users logged-in (unit {{ $labels.juju_unit }} in model {{ $labels.juju_model }})
      description: >-
        Host has {{ $value }} users logged-in.
          VALUE = {{ $value }}
          LABELS = {{ $labels }}
