groups:
- name: HostConnctrack
  rules:
  - alert: HostConntrackLimit
    expr: 100 * (node_nf_conntrack_entries / node_nf_conntrack_entries_limit) > 80
    for: 15m
    labels:
      severity: warning
    annotations:
      summary: Host conntrack reached {{ $value | printf "%.0f" }}% (application {{ $labels.juju_unit }} in model {{ $labels.juju_model }})
      description: >-
        Host conntrack reached {{ $value | printf "%.0f" }}% usage.
          VALUE = {{ $value }}
          LABELS = {{ $labels }}
